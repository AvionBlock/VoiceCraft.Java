{
  "schemaVersion": 1,
  "id": "voicecraft-java",
  "version": "${version}",
  "name": "VoiceCraft.Java",
  "description": "${description}",
  "authors": [
    "lil-jon-crunk"
  ],
  "contact": {
    "homepage": "https://java.voicecraft.chat"
  },
  "license": "GPL-3.0-or-later",
  "environment": "server",
  "entrypoints": {
    "preLaunch": [
      "team.avion.fabric.FabricNativeVoiceConfigPreLaunch"
    ],
    "main": [
      "team.avion.fabric.VoiceCraftJava"
    ],
    "voicechat": [
      "team.avion.fabric.adapters.simplevoicechat.FabricSimpleVoiceChatBridge"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabricLoaderVersion}",
    "fabric-api": ">=${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=${targetJavaVersion}"
  },
  "suggests": {
    "voicechat": "*",
    "plasmovoice": "*"
  }
}
